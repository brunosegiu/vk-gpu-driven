#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_samplerless_texture_functions : enable

#include "definitions.glsl"
#include "ddgiUtils.glsl"
#include "blurReflectionsParameters.glsl"
#include "utils.glsl"

#define LOCAL_SIZE_X 8
#define LOCAL_SIZE_Y 8
#define MAX_RADIUS 8
#define TILE_SIZE 32 

layout(local_size_x = LOCAL_SIZE_X, local_size_y = LOCAL_SIZE_Y) in;

shared vec3 TileRadiance[TILE_SIZE][TILE_SIZE];
shared float Tiledepth[TILE_SIZE][TILE_SIZE];

vec4 sampleRadianceHitDepth(ivec2 coords, ivec2 size) {
    coords = clamp(coords, ivec2(0), size - ivec2(1));
    return texelFetch(sampler2D(uInReflections, uFramebufferSampler), coords, 0);
}

float sampleDepth(ivec2 srcCoords, ivec2 srcSize) {
    ivec2 depthSize = textureSize(uInDepthBuffer, 0);
    vec2 scale = vec2(depthSize) / vec2(srcSize);
    ivec2 coords = ivec2(round((vec2(srcCoords) + 0.5) * scale));
    coords = clamp(coords, ivec2(0), depthSize - ivec2(1));
    float deviceDepth = texelFetch(sampler2D(uInDepthBuffer, uFramebufferSampler), coords, 0).r;
    return linearizeDepth(deviceDepth, uCameraParameters.far, uCameraParameters.near);
}

float depthEdgeStoppingWeight(float centerDepth, float sampleDepth, float phi) {
    float referenceDepth = max(centerDepth, sampleDepth);
    float sigmaDepthAbs = max(1e-6, phi * referenceDepth);
    float depthDifference = abs(centerDepth - sampleDepth);
    float normalizedDifference = depthDifference / sigmaDepthAbs;
    return 2.0f * (normalizedDifference * normalizedDifference);
}

void main() {
    ivec2 dstSize = imageSize(uOutBlurredReflections);
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 srcSize = textureSize(uInReflections, 0);

    ivec2 groupBaseCoord = ivec2(gl_WorkGroupID.xy * ivec2(LOCAL_SIZE_X, LOCAL_SIZE_Y)) * 2 + 1;
    ivec2 tileStart = groupBaseCoord - MAX_RADIUS;

    uint listSize = TILE_SIZE * TILE_SIZE;
    for (uint i = gl_LocalInvocationIndex; i < listSize; i += (LOCAL_SIZE_X * LOCAL_SIZE_Y)) {
        ivec2 localPos = ivec2(i % TILE_SIZE, i / TILE_SIZE);
        ivec2 globalPos = tileStart + localPos;
        
        vec4 rad = sampleRadianceHitDepth(globalPos, srcSize);
        TileRadiance[localPos.y][localPos.x] = rad.rgb;
        Tiledepth[localPos.y][localPos.x] = sampleDepth(globalPos, srcSize);
    }

    barrier();

    ivec2 centerCoords = dstCoord * 2 + 1;
    ivec2 localCenter = centerCoords - tileStart;
    
    vec3 radianceCenter = TileRadiance[localCenter.y][localCenter.x];
    float centerDepth = Tiledepth[localCenter.y][localCenter.x];
    
    float hitDistance = sampleRadianceHitDepth(centerCoords, srcSize).a;

    // Scale the radius based on how far the ray traveled. 
    int r = clamp(int(hitDistance * uControl.sigmaSpatial), 1, MAX_RADIUS);

    float twoSigma2 = 2.0 * uControl.sigmaSpatial * uControl.sigmaSpatial;

    vec3 sumRadiance = vec3(0.0);
    float sumWeight = 0.0;

    for (int dy = -r; dy <= r; ++dy) {
        for (int dx = -r; dx <= r; ++dx) {
            ivec2 sampleLocalPos = localCenter + ivec2(dx, dy);
            
            vec3 sampleRadiance = TileRadiance[sampleLocalPos.y][sampleLocalPos.x];
            float sampleDepthVal = Tiledepth[sampleLocalPos.y][sampleLocalPos.x];

            float weightSpatial = exp(-(dx * dx + dy * dy) / twoSigma2);
            float depthStop = depthEdgeStoppingWeight(centerDepth, sampleDepthVal, uControl.sigmaDepth);
            float weightDepth = exp(-max(0.0f, depthStop));

            float weight = weightSpatial * weightDepth;

            sumRadiance += weight * sampleRadiance;
            sumWeight += weight;
        }
    }

    vec3 totalRadiance = (sumWeight > 1e-3) ? sumRadiance / sumWeight : radianceCenter;
    imageStore(uOutBlurredReflections, dstCoord, vec4(totalRadiance, 1.0f));
}