#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_GOOGLE_include_directive : enable

#include "definitions.glsl"
#include "ddgiUtils.glsl"
#include "raytraceProbeParameters.glsl"

layout(location = ColorPayloadIndex) rayPayloadEXT RayPayload rayPayload;

vec3 sphericalFibonacci(float i, float n)
{
    const float _PHI = sqrt(5.0f) * 0.5 + 0.5;
#define madfrac(A, B) ((A) * (B) - floor((A) * (B)))
    float phi       = 2.0f * PI * madfrac(i, _PHI - 1.0f);
    float cosTheta = 1.0f - (2.0f * i + 1.0f) * (1.0 / n);
    float sinTheta = sqrt(clamp(1.0f - cosTheta * cosTheta, 0.0f, 1.0f));

    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
#undef madfrac
}

void main() {
    const uint rayIndex = gl_LaunchIDEXT.x;
    const uint probeIndex = gl_LaunchIDEXT.y;
    const uvec3 gridIndex = probeIndexToGridIndex(probeIndex, uDDGI);

    vec3 origin = gridIndexToWorldPos(ivec3(gridIndex), uDDGI);
    vec3 direction = uDDGI.randomRotation * sphericalFibonacci(rayIndex, gl_LaunchSizeEXT.x);

    rayPayload.color = vec3(0.0f);
    rayPayload.depth = 0;
    rayPayload.hitDepth = uDDGI.maxRayLength;

    traceRayEXT(
        uTopLevelAS,
        gl_RayFlagsOpaqueEXT,
        AllMask,
        DefaultSBTOffset,
        DefaultSBTStride,
        ColorMissIndex,
        origin,
        uDDGI.minRayLength,
        direction,
        uDDGI.maxRayLength,
        ColorPayloadIndex);

    imageStore(uProbeIrradianceTargets, ivec2(gl_LaunchIDEXT.xy), vec4(rayPayload.color, 0.0));
    imageStore(uProbeDirectionDepth, ivec2(gl_LaunchIDEXT.xy), vec4(direction, rayPayload.hitDepth));
}
